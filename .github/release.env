# Per release knobs of .github/workflows/release.yml. The prepare job checks
# them (.github/scripts/release-env.sh) before anything is built, and the
# publish job writes them into the signed manifest. Edit them in the commit
# the release tag points at, not afterwards: they describe what upgrading to
# this release does. The file is read as shell assignments, so a value with
# spaces goes in double quotes, and a $, a backquote or a backslash inside
# them needs a backslash in front.

# The one line kvsctl shows beside the version: what this release changes for
# the people who run it. Required, and written again for every release, since
# the previous one stays here otherwise. The full notes, which git-cliff
# writes from the commits, are the body of the GitHub release.
NOTES="First release for kvsctl: prebuilt images pinned by digest"

# Up to three more lines for the confirmation screen of kvsctl upgrade and
# for kvsctl check: what an operator should know before saying yes. Each is
# optional and one line; empty them, or write them again, for every release.
HIGHLIGHT_1="Images come from GHCR instead of a build on the server"
HIGHLIGHT_2="The database is backed up first; a failed upgrade rolls back"
HIGHLIGHT_3="PHP and cron trust the self-signed certificate of the site"

# The oldest stack version allowed to upgrade straight to this one. Empty
# means any version may. kvsctl carries the database flags of every release
# it jumps over, so a one-way release does not have to be a stop: set this
# only when an older version must not go straight to this one.
MIN_FROM=

# none or migrates. migrates tells kvsctl the release changes the database,
# so a rollback restores the backup instead of only restarting the previous
# images.
DATABASE=none

# true when the release cannot be undone by restarting the previous images:
# kvsctl then refuses --skip-backup, and a rollback recreates the MariaDB data
# directory and replays the backup. A MariaDB series change does not need it:
# each stack asks for one (kvsctl upgrade --mariadb-series), and kvsctl
# treats that upgrade as one way by itself.
ONE_WAY=false

# The oldest KVS the release supports.
KVS_MIN=7.0.0

# The oldest kvsctl that may install this release, for a release that needs
# something only a newer kvsctl does: kvsctl check and kvsctl upgrade on an
# older one stop and ask for kvsctl update-cli first. At most the version of
# this release, whose kvsctl update-cli installs; a candidate of that version
# (26.11.0-rc1 for 26.11.0) asks for its own kvsctl instead. Empty means any
# kvsctl that reads the manifest may install it.
KVSCTL_MIN=

# The oldest Docker Compose that reads the release override. The override
# clears the build sections of the base compose file with
# "build: !reset null", which Compose applies from 2.19.0 on; 2.18 reads it
# as a build from a directory named null, and fails to build it. The
# installer asks the same version of an installation kvsctl manages
# (docker/setup.sh), and tests/test_release_env.sh keeps the two equal.
COMPOSE_MIN=2.19.0

# During a key rotation (docs/releasing.md), the key a later release signs
# with alone: ID=BASE64, or ID=BASE64@YYYY-MM-DD with the day it takes over,
# where ID is the key id kvsctl-release keygen prints. A kvsctl that does not
# trust it yet tells its operator to run kvsctl update-cli. Empty otherwise.
ANNOUNCE_KEY=
