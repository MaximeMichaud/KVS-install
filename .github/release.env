# Per release knobs the publish job of .github/workflows/release.yml reads.
# Edit them in the commit the release tag points at, not afterwards: they end
# up in the signed manifest and describe what upgrading to this release does.

# The oldest stack version allowed to upgrade straight to this one. Empty
# means any version may. Set it to the version just before this one to make
# this release a required stop, which every one-way release must be.
MIN_FROM=

# none or migrates. migrates tells kvsctl the release changes the database,
# so a rollback restores the backup instead of only restarting the previous
# images.
DATABASE=none

# true when the release cannot be undone by restarting the previous images,
# a MariaDB major upgrade being the usual reason: the datadir has been
# rewritten and the older server refuses to open it. It makes --skip-backup
# an error and sends a rollback down the volume-recreating path.
ONE_WAY=false

# The oldest KVS the release supports.
KVS_MIN=7.0.0

# The oldest Compose that understands the release override. The override
# clears the build key with "build: !reset null", which needs Compose 2.24.
COMPOSE_MIN=2.24.0
