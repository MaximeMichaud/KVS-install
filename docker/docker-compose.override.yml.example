# Local changes to the stack belong in docker-compose.override.yml: an
# upgrade replaces the release files under docker/ and conf/ and keeps this
# one. Anything that is not a Compose setting goes to .env.
#
# The site files need no override: docker-compose.yml mounts
# /var/www/${DOMAIN} in nginx, php-fpm, cron and kvs-init, and kvs-init
# gives its entries their owner, 1000:1000, at every setup. The entries
# below repeat those mounts as an example; replace them with your changes.
#
# 1. Copy this file: cp docker-compose.override.yml.example docker-compose.override.yml
# 2. Write your changes in it.
# 3. If .env sets COMPOSE_FILE, add docker-compose.override.yml to it, right
#    after docker-compose.yml. setup.sh and the next kvsctl upgrade or
#    rollback do it too; until then, kvsctl status reports that compose
#    ignores the file.
# 4. Run: docker compose up -d

services:
  nginx:
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs

  php-fpm:
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs

  cron:
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs

  kvs-init:
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
