# Domain Configuration
# DOMAIN is limited to 64 characters because it is also the MariaDB identifier.
DOMAIN=example.com
EMAIL=admin@example.com
USE_WWW=false

# Container and volume prefix for multi-site support
# Default: kvs (containers: kvs-php, kvs-mariadb, volumes: kvs_mariadb-data, etc.)
# Multi-site example: kvs-mysite (containers: kvs-mysite-php, volumes: kvs-mysite_mariadb-data)
SITE_PREFIX=kvs
COMPOSE_PROJECT_NAME=kvs

# SSL Provider: letsencrypt, zerossl, or selfsigned
# selfsigned = for development, or when behind a reverse proxy (Cloudflare, HAProxy, etc.)
# Multi-site mode supports letsencrypt or selfsigned because Caddy manages TLS.
SSL_PROVIDER=letsencrypt

# MariaDB - Generate passwords with: openssl rand -base64 24
MARIADB_VERSION=11.8
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_PASSWORD=CHANGE_ME_KVS_PASSWORD

# PHP Configuration
# setup.sh detects this from the KVS archive when available.
# PHP 8.1 is for KVS 6.2.1+; KVS 5.x, 6.0-6.2.0 use PHP 7.4.
PHP_VERSION=8.1
IONCUBE=YES
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=2048M
PHP_POST_MAX_SIZE=2048M
PHP_MAX_EXECUTION_TIME=300

# Cache: dragonfly (recommended, faster) or memcached (legacy)
# Note: PHP sessions use files, Dragonfly is for KVS object cache only
COMPOSE_PROFILES=dragonfly
CACHE_MEMORY=512

# Public ports (change if 80/443 are in use) - ignored in multi mode.
# PORT, IPv4:PORT, and [IPv6]:PORT forms are supported.
HTTP_PORT=80
HTTPS_PORT=443
# Canonical HTTPS port embedded in KVS URLs. setup.sh derives this from
# HTTPS_PORT and forces 443 when Caddy handles the public endpoint.
PROJECT_HTTPS_PORT=443

# Localhost-only service ports (change them when running multiple primary stacks)
MARIADB_HOST_PORT=3306
CACHE_HOST_PORT=11211
MANTICORE_MYSQL_HOST_PORT=9306
MANTICORE_HTTP_HOST_PORT=9308

# Mode: single (direct nginx) or multi (Caddy reverse proxy)
# single = less latency, 1 site only
# multi = Caddy handles SSL/routing, multiple sites supported
MODE=single
