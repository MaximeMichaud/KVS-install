# Domain Configuration
# DOMAIN is limited to 64 characters because it is also the MariaDB identifier.
DOMAIN=example.com
EMAIL=admin@example.com
USE_WWW=false

# Container and volume prefix for multi-site support
# Default: kvs (containers: kvs-php, kvs-mariadb, volumes: kvs_mariadb-data, etc.)
# Multi-site example: kvs-mysite (containers: kvs-mysite-php, volumes: kvs-mysite_mariadb-data)
SITE_PREFIX=kvs
COMPOSE_PROJECT_NAME=kvs

# SSL Provider: letsencrypt, zerossl, or selfsigned
# selfsigned = for development, or when behind a reverse proxy (Cloudflare, HAProxy, etc.)
# In single-site mode PHP and cron trust NGINX's self-signed certificate automatically.
# Certificate and hostname verification remain enabled, including for new storage servers.
# Multi-site mode supports letsencrypt or selfsigned because Caddy manages TLS.
SSL_PROVIDER=letsencrypt

# MariaDB - Generate passwords with: openssl rand -base64 24
MARIADB_VERSION=12.3
# setup.sh persists 50% of available RAM, rounded down in 128M steps.
# Host, cgroup and Compose limits apply. Explicit/saved sizes are preserved.
# Set a size such as 8G, or auto to request a new calculation during setup.
MARIADB_BUFFER_POOL_SIZE=
# Redo is disk space: auto selects half the pool, bounded to 128M..2G.
# Both settings apply before SQL initialization and survive restarts.
MARIADB_REDO_LOG_SIZE=
# How long docker compose stop and down wait for MariaDB to shut down
# before killing it, as a duration with its unit (600s, 15m). It applies
# to a container created with it.
MARIADB_STOP_GRACE_PERIOD=10m
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MARIADB_PASSWORD=CHANGE_ME_KVS_PASSWORD

# PHP Configuration
# setup.sh detects this from the KVS archive when available.
# PHP 8.1 is for KVS 6.2.1+; KVS 5.x, 6.0-6.2.0 use PHP 7.4.
# An IonCube encoded archive only runs on the version its files were encoded
# for, so setup.sh enforces the detected one. With IONCUBE=NO the version is
# yours to pick: 7.4, 8.1, 8.2, 8.3 or 8.4, either at the prompt or by
# exporting KVS_PHP_VERSION before running setup.sh.
PHP_VERSION=8.1
IONCUBE=YES
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_MAX_FILESIZE=2048M
PHP_POST_MAX_SIZE=2048M
PHP_MAX_EXECUTION_TIME=300

# KVS support access: Kernel Team can log in with the kvs_support account,
# from its own address only, while this KVS option is enabled. KVS ships it
# enabled. true sets ENABLE_KVS_SUPPORT_ACCESS=0 during setup; the admin
# dashboard re-enables it at any time.
DISABLE_KVS_SUPPORT_ACCESS=false

# Cache: dragonfly (recommended, faster) or memcached (legacy)
# Note: PHP sessions use files, Dragonfly is for KVS object cache only
# CACHE_MEMORY is the cache ceiling in MB and CACHE_THREADS the Dragonfly
# thread count (Dragonfly needs 256 MB per thread). On hosts with less than
# 2 GB of RAM, setup.sh lowers the ceiling to a quarter of the RAM and runs
# Dragonfly on one thread.
COMPOSE_PROFILES=dragonfly
CACHE_MEMORY=512
CACHE_THREADS=2

# Public ports (change if 80/443 are in use) - ignored in multi mode.
# PORT, IPv4:PORT, and [IPv6]:PORT forms are supported.
HTTP_PORT=80
HTTPS_PORT=443
# Canonical HTTPS port embedded in KVS URLs. setup.sh derives this from
# HTTPS_PORT and forces 443 when Caddy handles the public endpoint.
PROJECT_HTTPS_PORT=443

# Localhost-only service ports (change them when running multiple primary stacks)
MARIADB_HOST_PORT=3306
CACHE_HOST_PORT=11211
MANTICORE_MYSQL_HOST_PORT=9306
MANTICORE_HTTP_HOST_PORT=9308

# Logs
# Docker keeps what each container prints (docker compose logs) in at most
# DOCKER_LOG_MAX_FILE json-file files of DOCKER_LOG_MAX_SIZE. These
# containers use json-file even where /etc/docker/daemon.json sets another
# log-driver; the README says how to keep it. Nginx rotates
# <domain>.access.log and <domain>.error.log itself when one reaches
# NGINX_LOG_MAX_SIZE (a k, M or G suffix counts in powers of 1024; checked
# every NGINX_LOG_CHECK_INTERVAL seconds; 0 turns the rotation off) and keeps
# NGINX_LOG_KEEP gzip-compressed generations.
# Changes apply to recreated containers: docker compose up -d
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
NGINX_LOG_MAX_SIZE=100M
NGINX_LOG_KEEP=20
NGINX_LOG_CHECK_INTERVAL=60

# Mode: single (direct nginx) or multi (Caddy reverse proxy)
# single = less latency, 1 site only
# multi = Caddy handles SSL/routing, multiple sites supported
MODE=single
