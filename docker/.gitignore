# Sensitive files
.env
# The lock setup.sh and reconfigure.sh hold while they run
.kvs-scripts.lock
kvs-archive/

# Generated files
nginx/dhparam.pem
nginx/ssl/
nginx/conf.d/*.conf

# Docker volumes (if using bind mounts)
data/
docker-compose.override.yml

# Multi-site generated files
multi-site/sites/
multi-site/caddy/sites/*.caddy
