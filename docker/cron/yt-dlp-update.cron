# /etc/cron.d system crontab for the privileged yt-dlp binary update.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# The script checks the sha256 the release publishes before replacing the
# executable. The entrypoint removes this file when YT_DLP_AUTO_UPDATE is no.
0 4 * * 0 root /usr/local/bin/yt-dlp-update >> /var/log/yt-dlp-update.log 2>&1
