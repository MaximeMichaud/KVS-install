# /etc/cron.d system crontab for the privileged yt-dlp update.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# The script installs a newer release in the yt-dlp volume once its sha256 is
# the one the release publishes. The entrypoint removes this file when the
# updates are off: YT_DLP_AUTO_UPDATE is no, or no yt-dlp volume is mounted.
0 4 * * 0 root /usr/local/bin/yt-dlp-update >> /var/log/yt-dlp-update.log 2>&1
