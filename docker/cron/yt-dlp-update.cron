# /etc/cron.d system crontab for the privileged yt-dlp binary update.
SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# Replace the executable only after a complete download.
0 4 * * 0 root { curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/.yt-dlp.new && chmod 0755 /usr/local/bin/.yt-dlp.new && mv -f /usr/local/bin/.yt-dlp.new /usr/local/bin/yt-dlp; } >> /var/log/yt-dlp-update.log 2>&1
