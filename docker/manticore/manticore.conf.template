{
    source = ${DOMAIN_SAFE}_searches
    morphology = stem_en
    min_word_len = 2
    min_infix_len = 2
    index_exact_words = 1

    path = /var/lib/manticore/${DOMAIN_SAFE}_searches

    charset_table = 0..9, A..Z->a..z, _, a..z, U+410..U+42F->U+430..U+44F, U+430..U+44F
}
