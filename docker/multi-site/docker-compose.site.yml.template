# =============================================================================
# KVS Multi-Site - Site Template
# =============================================================================
#
# Individual KVS site running behind Caddy reverse proxy.
# This file is copied to sites/<domain>/docker-compose.yml
#
# =============================================================================

# =============================================================================
# Logging - Docker keeps what each container prints in json-file logs that
# grow without end unless capped. Every service, the one-shots included,
# takes this cap; DOCKER_LOG_MAX_SIZE and DOCKER_LOG_MAX_FILE in the site's
# .env change it for the containers created afterwards.
# =============================================================================
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "${DOCKER_LOG_MAX_SIZE:-10m}"
    max-file: "${DOCKER_LOG_MAX_FILE:-3}"

services:
  # ===========================================================================
  # Nginx - Web Server
  # ===========================================================================
  nginx:
    build:
      context: ../../../nginx
      args:
        - DOMAIN=${DOMAIN}
    container_name: ${SITE_PREFIX}-nginx
    restart: unless-stopped
    logging: *default-logging
    volumes:
      - ../../../nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ../../nginx/kvs-caddy.conf.template:/etc/nginx/templates/kvs.conf.template:ro
      - ../../../../conf/nginx/globals:/etc/nginx/globals:ro
      - /var/www/${DOMAIN}:/var/www/kvs
      - manticore-api:/var/www/manticore-api
      - phpmyadmin-data:/usr/share/phpmyadmin:ro
      - nginx-includes:/etc/nginx/includes:ro
      # The site logs and their generations outlive a recreated container.
      - nginx-logs:/var/log/nginx
    environment:
      - DOMAIN=${DOMAIN}
      - USE_WWW=${USE_WWW:-false}
      - SSL_PROVIDER=none
      - PROJECT_HTTPS_PORT=443
      # Rotation of <domain>.access.log and <domain>.error.log, done by the
      # container itself (nginx/rotate-site-logs.sh).
      - NGINX_LOG_MAX_SIZE=${NGINX_LOG_MAX_SIZE:-100M}
      - NGINX_LOG_KEEP=${NGINX_LOG_KEEP:-20}
      - NGINX_LOG_CHECK_INTERVAL=${NGINX_LOG_CHECK_INTERVAL:-60}
    depends_on:
      php-fpm:
        condition: service_started
    networks:
      kvs-proxy:
        aliases:
          - n.${DOMAIN}
      site-internal:
    healthcheck:
      test: ["CMD", "curl", "-fsS", "-H", "Host: ${DOMAIN}", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  # ===========================================================================
  # PHP-FPM
  # ===========================================================================
  php-fpm:
    build:
      context: ../../../php
      args:
        PHP_VERSION: ${PHP_VERSION:-8.1}
        IONCUBE: ${IONCUBE:-YES}
    container_name: ${SITE_PREFIX}-php
    restart: unless-stopped
    logging: *default-logging
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
      - manticore-api:/var/www/manticore-api
      - phpmyadmin-data:/usr/share/phpmyadmin
      - ../../../php/php.ini:/usr/local/etc/php/conf.d/kvs.ini:ro
    environment:
      - PHP_MEMORY_LIMIT=${PHP_MEMORY_LIMIT:-512M}
      - PHP_UPLOAD_MAX_FILESIZE=${PHP_UPLOAD_MAX_FILESIZE:-2048M}
      - PHP_POST_MAX_SIZE=${PHP_POST_MAX_SIZE:-2048M}
      - PHP_MAX_EXECUTION_TIME=${PHP_MAX_EXECUTION_TIME:-300}
    depends_on:
      mariadb:
        condition: service_healthy
    networks:
      - site-internal

  # ===========================================================================
  # MariaDB
  # ===========================================================================
  mariadb:
    image: mariadb:${MARIADB_VERSION:-12.3}
    command:
      - "--innodb-buffer-pool-size=${MARIADB_BUFFER_POOL_SIZE:-128M}"
      - "--innodb-log-file-size=${MARIADB_REDO_LOG_SIZE:-128M}"
      # kvs-export.sh dumps rows up to 512M; replaying one of more than
      # 16M, the default, stopped the import with "Server has gone away".
      - "--max-allowed-packet=1G"
    container_name: ${SITE_PREFIX}-mariadb
    # docker stop sends SIGTERM and, by default, SIGKILL 10 s later, which
    # can cut MariaDB short while it flushes its changed pages and leave a
    # crash recovery to the next start. A duration with its unit (600s,
    # 15m); a host shutdown may allow less, see the README.
    stop_grace_period: ${MARIADB_STOP_GRACE_PERIOD:-10m}
    # While it initializes the database on the first start, the image's
    # entrypoint is a bash PID 1 with no SIGTERM handler, so docker stop
    # waited out the whole grace period. Docker's init takes PID 1 and
    # forwards SIGTERM to the entrypoint, then to mariadbd, which still
    # gets the whole period to shut down.
    init: true
    restart: unless-stopped
    logging: *default-logging
    environment:
      MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD:?error}
      MARIADB_DATABASE: ${DOMAIN}
      MARIADB_USER: ${DOMAIN}
      MARIADB_PASSWORD: ${MARIADB_PASSWORD:?error}
      MARIADB_MYSQL_LOCALHOST_USER: 1
    volumes:
      - mariadb-data:/var/lib/mysql
      - ../../../mariadb/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - site-internal

  # ===========================================================================
  # Cache - Dragonfly (default)
  # ===========================================================================
  dragonfly:
    image: docker.dragonflydb.io/dragonflydb/dragonfly:latest
    container_name: ${SITE_PREFIX}-cache
    restart: unless-stopped
    logging: *default-logging
    ulimits:
      memlock: -1
    command: ["--memcached_port=11211", "--maxmemory", "${CACHE_MEMORY:-512}mb", "--proactor_threads", "2"]
    networks:
      site-internal:
        aliases:
          - cache
    profiles:
      - dragonfly

  # ===========================================================================
  # Cache - Memcached (alternative)
  # ===========================================================================
  memcached:
    image: memcached:alpine
    container_name: ${SITE_PREFIX}-memcached
    restart: unless-stopped
    logging: *default-logging
    command: ["-m", "${CACHE_MEMORY:-512}"]
    networks:
      site-internal:
        aliases:
          - cache
    profiles:
      - memcached

  # ===========================================================================
  # Cron
  # ===========================================================================
  cron:
    build:
      context: ../../../cron
      args:
        PHP_VERSION: ${PHP_VERSION:-8.1}
    container_name: ${SITE_PREFIX}-cron
    # cron -f installs no SIGTERM handler, and the kernel drops such a signal
    # sent to PID 1, so docker stop waited out its whole timeout before
    # SIGKILL. Docker's init takes PID 1, passes SIGTERM on and reaps orphans.
    init: true
    restart: unless-stopped
    logging: *default-logging
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
    depends_on:
      - php-fpm
    networks:
      - site-internal

  # ===========================================================================
  # KVS Init (one-time setup)
  # ===========================================================================
  kvs-init:
    build:
      context: ../../../init
    container_name: ${SITE_PREFIX}-init
    logging: *default-logging
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
      - manticore-api:/var/www/manticore-api
      - ../../../kvs-archive:/kvs-archive:ro
      - nginx-includes:/nginx-includes
    environment:
      - DOMAIN=${DOMAIN}
      - USE_WWW=${USE_WWW:-false}
      - MARIADB_HOST=mariadb
      - MARIADB_USER=${DOMAIN}
      - MARIADB_PASSWORD=${MARIADB_PASSWORD}
      - MARIADB_DATABASE=${DOMAIN}
      - SSL_PROVIDER=selfsigned
      - PROJECT_HTTPS_PORT=443
      - KVS_ADMIN_PASSWORD=${KVS_ADMIN_PASSWORD:-}
      - DISABLE_KVS_SUPPORT_ACCESS=${DISABLE_KVS_SUPPORT_ACCESS:-false}
    depends_on:
      mariadb:
        condition: service_healthy
    networks:
      - site-internal
    profiles:
      - setup

  # ===========================================================================
  # phpMyAdmin Init
  # ===========================================================================
  phpmyadmin-init:
    image: alpine:latest
    container_name: ${SITE_PREFIX}-phpmyadmin-init
    logging: *default-logging
    entrypoint: ["/usr/local/bin/init-phpmyadmin"]
    volumes:
      - phpmyadmin-data:/usr/share/phpmyadmin
      - ../../../phpmyadmin/init.sh:/usr/local/bin/init-phpmyadmin:ro
    profiles:
      - setup

# =============================================================================
# Networks
# =============================================================================
networks:
  kvs-proxy:
    external: true
  site-internal:
    driver: bridge

# =============================================================================
# Volumes
# =============================================================================
volumes:
  manticore-api:
  mariadb-data:
  phpmyadmin-data:
  nginx-includes:
  nginx-logs:
