# =============================================================================
# KVS Multi-Site - Site Template
# =============================================================================
#
# Individual KVS site running behind Caddy reverse proxy.
# This file is copied to sites/<domain>/docker-compose.yml
#
# =============================================================================

# =============================================================================
# Logging - Docker keeps what each container prints in json-file logs that
# grow without end unless capped. Every service, the one-shots included,
# takes this cap; DOCKER_LOG_MAX_SIZE and DOCKER_LOG_MAX_FILE in the site's
# .env change it for the containers created afterwards.
# =============================================================================
x-logging: &default-logging
  driver: json-file
  options:
    max-size: "${DOCKER_LOG_MAX_SIZE:-10m}"
    max-file: "${DOCKER_LOG_MAX_FILE:-3}"

services:
  # ===========================================================================
  # Nginx - Web Server
  # ===========================================================================
  nginx:
    build:
      context: ../../../nginx
      args:
        - DOMAIN=${DOMAIN}
    container_name: ${SITE_PREFIX}-nginx
    restart: unless-stopped
    logging: *default-logging
    volumes:
      - ../../../nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ../../nginx/kvs-caddy.conf.template:/etc/nginx/templates/kvs.conf.template:ro
      - ../../../../conf/nginx/globals:/etc/nginx/globals:ro
      - /var/www/${DOMAIN}:/var/www/kvs
      - manticore-api:/var/www/manticore-api
      - phpmyadmin-data:/usr/share/phpmyadmin:ro
      - nginx-includes:/etc/nginx/includes:ro
      # The site logs and their generations outlive a recreated container.
      - nginx-logs:/var/log/nginx
    environment:
      - DOMAIN=${DOMAIN}
      - USE_WWW=${USE_WWW:-false}
      - SSL_PROVIDER=none
      - PROJECT_HTTPS_PORT=443
      # Rotation of <domain>.access.log and <domain>.error.log, done by the
      # container itself (nginx/rotate-site-logs.sh).
      - NGINX_LOG_MAX_SIZE=${NGINX_LOG_MAX_SIZE:-100M}
      - NGINX_LOG_KEEP=${NGINX_LOG_KEEP:-20}
      - NGINX_LOG_CHECK_INTERVAL=${NGINX_LOG_CHECK_INTERVAL:-60}
    depends_on:
      php-fpm:
        condition: service_started
    networks:
      kvs-proxy:
        aliases:
          - n.${DOMAIN}
      site-internal:
    healthcheck:
      # Nginx closes the connection (444) on a request for a host it does
      # not serve, a missing Host header included, so the probe names the
      # site. Nginx answers /health itself (200), without PHP-FPM.
      test: ["CMD", "curl", "-fsS", "-o", "/dev/null", "-H", "Host: ${DOMAIN}", "http://127.0.0.1/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s

  # ===========================================================================
  # PHP-FPM
  # ===========================================================================
  php-fpm:
    build:
      context: ../../../php
      args:
        PHP_VERSION: ${PHP_VERSION:-8.1}
        # Empty when the site's .env names no base (a site added before the
        # lock): the Dockerfile then builds from the php:<PHP_VERSION>-fpm
        # tag. A default nested in this one would stop Docker Compose older
        # than 2.18 from reading this file.
        PHP_BASE: ${PHP_FPM_BASE:-}
    container_name: ${SITE_PREFIX}-php
    restart: unless-stopped
    logging: *default-logging
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
      - manticore-api:/var/www/manticore-api
      - phpmyadmin-data:/usr/share/phpmyadmin
      - ../../../php/php.ini:/usr/local/etc/php/conf.d/kvs.ini:ro
      # The newer yt-dlp releases the cron container installs, read here.
      - yt-dlp:/var/lib/yt-dlp:ro
    environment:
      - PHP_MEMORY_LIMIT=${PHP_MEMORY_LIMIT:-512M}
      - PHP_UPLOAD_MAX_FILESIZE=${PHP_UPLOAD_MAX_FILESIZE:-2048M}
      - PHP_POST_MAX_SIZE=${PHP_POST_MAX_SIZE:-2048M}
      - PHP_MAX_EXECUTION_TIME=${PHP_MAX_EXECUTION_TIME:-300}
      - IONCUBE=${IONCUBE:-YES}
      # Read when the container starts, like in cron: both run the newer
      # yt-dlp of the volume, or with no both keep the one of their image.
      - YT_DLP_AUTO_UPDATE=${YT_DLP_AUTO_UPDATE:-yes}
    depends_on:
      mariadb:
        condition: service_healthy
    healthcheck:
      # socat is installed in the image (php/Dockerfile) and a TCP connect
      # proves the FastCGI master accepts requests, which "php-fpm -t" only
      # tells about the configuration file.
      test: ["CMD", "socat", "-u", "/dev/null", "TCP:127.0.0.1:9000"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    networks:
      - site-internal

  # ===========================================================================
  # MariaDB
  # ===========================================================================
  mariadb:
    image: mariadb:${MARIADB_VERSION:-12.3}
    command:
      - "--innodb-buffer-pool-size=${MARIADB_BUFFER_POOL_SIZE:-128M}"
      - "--innodb-log-file-size=${MARIADB_REDO_LOG_SIZE:-128M}"
      # kvs-export.sh dumps rows up to 512M; replaying one of more than
      # 16M, the default, stopped the import with "Server has gone away".
      - "--max-allowed-packet=1G"
    container_name: ${SITE_PREFIX}-mariadb
    # docker stop sends SIGTERM and, by default, SIGKILL 10 s later, which
    # can cut MariaDB short while it flushes its changed pages and leave a
    # crash recovery to the next start. A duration with its unit (600s,
    # 15m); a host shutdown may allow less, see the README.
    stop_grace_period: ${MARIADB_STOP_GRACE_PERIOD:-10m}
    # While it initializes the database on the first start, the image's
    # entrypoint is a bash PID 1 with no SIGTERM handler, so docker stop
    # waited out the whole grace period. Docker's init takes PID 1 and
    # forwards SIGTERM to the entrypoint, then to mariadbd, which still
    # gets the whole period to shut down.
    init: true
    restart: unless-stopped
    logging: *default-logging
    environment:
      MARIADB_ROOT_PASSWORD: ${MARIADB_ROOT_PASSWORD:?error}
      MARIADB_DATABASE: ${DOMAIN}
      MARIADB_USER: ${DOMAIN}
      MARIADB_PASSWORD: ${MARIADB_PASSWORD:?error}
      MARIADB_MYSQL_LOCALHOST_USER: 1
      MARIADB_AUTO_UPGRADE: 1
    volumes:
      - mariadb-data:/var/lib/mysql
      - ../../../mariadb/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      # Failures inside the start period do not count, and the first probe
      # that passes marks the container healthy. It covers the first start
      # on a new series, when a temporary server with no TCP port (the
      # probe connects over TCP) upgrades the system tables first
      # (MARIADB_AUTO_UPGRADE), and any long first start: five failed probes
      # would otherwise mark MariaDB unhealthy, and Compose then refuses to
      # start the services that wait for it to be healthy.
      start_period: 10m
    networks:
      - site-internal

  # ===========================================================================
  # Cache - Dragonfly (default)
  # ===========================================================================
  dragonfly:
    image: docker.dragonflydb.io/dragonflydb/dragonfly:latest
    container_name: ${SITE_PREFIX}-cache
    restart: unless-stopped
    logging: *default-logging
    ulimits:
      memlock: -1
    command: ["--memcached_port=11211", "--maxmemory", "${CACHE_MEMORY:-512}mb", "--proactor_threads", "2"]
    networks:
      site-internal:
        aliases:
          - cache
    profiles:
      - dragonfly

  # ===========================================================================
  # Cache - Memcached (alternative)
  # ===========================================================================
  memcached:
    image: memcached:alpine
    container_name: ${SITE_PREFIX}-memcached
    restart: unless-stopped
    logging: *default-logging
    command: ["-m", "${CACHE_MEMORY:-512}"]
    networks:
      site-internal:
        aliases:
          - cache
    profiles:
      - memcached

  # ===========================================================================
  # Cron
  # ===========================================================================
  cron:
    build:
      context: ../../../cron
      args:
        PHP_VERSION: ${PHP_VERSION:-8.1}
        PHP_BASE: ${PHP_CLI_BASE:-}
    container_name: ${SITE_PREFIX}-cron
    # cron -f installs no SIGTERM handler, and the kernel drops such a signal
    # sent to PID 1, so docker stop waited out its whole timeout before
    # SIGKILL. Docker's init takes PID 1, passes SIGTERM on and reaps orphans.
    init: true
    restart: unless-stopped
    logging: *default-logging
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
      # yt-dlp-update installs the newer yt-dlp releases here, for both
      # containers; a named volume, so they outlive a recreated container.
      - yt-dlp:/var/lib/yt-dlp
    environment:
      - IONCUBE=${IONCUBE:-YES}
      # yes: look for a newer yt-dlp at start and every Sunday; no: keep the
      # release of the image. Read when the container starts.
      - YT_DLP_AUTO_UPDATE=${YT_DLP_AUTO_UPDATE:-yes}
    depends_on:
      # Started, never healthy: the KVS tasks run PHP in this container and
      # waiting for the PHP-FPM socket would only delay the first tick.
      php-fpm:
        condition: service_started
    healthcheck:
      # The container listens on nothing, so the daemon itself is the signal.
      # procps is installed (cron/Dockerfile) for pgrep, which finds the
      # daemon by name: with init: true, PID 1 is Docker's init, not cron.
      test: ["CMD", "pgrep", "-x", "cron"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    networks:
      - site-internal

  # ===========================================================================
  # KVS Init (one-time setup)
  # ===========================================================================
  kvs-init:
    build:
      context: ../../../init
    container_name: ${SITE_PREFIX}-init
    logging: *default-logging
    volumes:
      - /var/www/${DOMAIN}:/var/www/kvs
      - manticore-api:/var/www/manticore-api
      - ../../../kvs-archive:/kvs-archive:ro
      - nginx-includes:/nginx-includes
    environment:
      - DOMAIN=${DOMAIN}
      - USE_WWW=${USE_WWW:-false}
      - MARIADB_HOST=mariadb
      - MARIADB_USER=${DOMAIN}
      - MARIADB_PASSWORD=${MARIADB_PASSWORD}
      - MARIADB_DATABASE=${DOMAIN}
      - SSL_PROVIDER=selfsigned
      - MODE=multi
      - PROJECT_HTTPS_PORT=443
      - KVS_ADMIN_PASSWORD=${KVS_ADMIN_PASSWORD:-}
      - DISABLE_KVS_SUPPORT_ACCESS=${DISABLE_KVS_SUPPORT_ACCESS:-false}
      # Unused on a site made from this template, which runs no Manticore:
      # kvs-init installs the plugin only with ENABLE_MANTICORE=true, which
      # this template does not pass. Kept in step with the main site's
      # kvs-init, like the manticore-api volume above.
      - MANTICORE_PLUGIN_URL=${MANTICORE_PLUGIN_URL:-}
      - MANTICORE_PLUGIN_SHA256=${MANTICORE_PLUGIN_SHA256:-}
    depends_on:
      mariadb:
        condition: service_healthy
    networks:
      - site-internal
    profiles:
      - setup

  # ===========================================================================
  # phpMyAdmin Init
  # ===========================================================================
  phpmyadmin-init:
    # The Alpine of docker/images.lock, whose BusyBox tools the tests run
    # init.sh with and which a release pins too: resolve-bases.sh keeps this
    # line on the lock.
    image: alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
    container_name: ${SITE_PREFIX}-phpmyadmin-init
    logging: *default-logging
    entrypoint: ["/usr/local/bin/init-phpmyadmin"]
    volumes:
      - phpmyadmin-data:/usr/share/phpmyadmin
      - ../../../phpmyadmin/init.sh:/usr/local/bin/init-phpmyadmin:ro
    profiles:
      - setup

# =============================================================================
# Networks
# =============================================================================
networks:
  kvs-proxy:
    external: true
  site-internal:
    driver: bridge

# =============================================================================
# Volumes
# =============================================================================
volumes:
  manticore-api:
  mariadb-data:
  phpmyadmin-data:
  nginx-includes:
  nginx-logs:
  yt-dlp:
